# Flask secret key - generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Supabase (PostgreSQL) connection string.
# Copy it from Supabase Dashboard > Project Settings > Database > Connection string
# and replace YOUR-PASSWORD with your database password.
# NOTE: .env is gitignored - never commit real credentials.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.csgxvwttunptjvwzrhdm.supabase.co:5432/postgres

# Alternative: individual connection parts (used only when DATABASE_URL is empty)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=financial_tracker

# Optional: display currency symbol
CURRENCY=$
